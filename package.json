{
  "name": "vesperfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:engine": "vitest run tests/engine.test.ts tests/bots.test.ts tests/cards.test.ts",
    "test:rules": "firebase emulators:exec --project demo-vesperfall --only firestore,database,auth \"vitest run tests/rules.test.ts tests/multiplayer.test.ts\"",
    "emulators": "firebase emulators:start --project demo-vesperfall",
    "bots:ladder": "tsx scripts/ladder.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "firebase": "^11.0.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@preact/preset-vite": "^2.9.0",
    "firebase-tools": "^14.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
